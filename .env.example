# Neo4j Database Connection
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Flask Web Server
PORT=5000
FLASK_DEBUG=True

# Optional: Google Gemini API Key for dynamic LLM Cypher generation & conversational polish
# If omitted, the system operates with its rule-based Discrete Mathematics Cypher generator
GEMINI_API_KEY=
