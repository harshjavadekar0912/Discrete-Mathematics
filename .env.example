# Google Maps Platform API Key
# Get yours at: https://console.cloud.google.com/apis/credentials
# Enable these APIs in Google Cloud Console:
#   1. Maps JavaScript API
#   2. Places API (New)
#   3. Routes API
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Flask Settings
FLASK_DEBUG=True
PORT=5000
