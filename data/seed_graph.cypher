CREATE (:Place:Hotel {id: 'hyd_falaknuma_palace', name: 'Taj Falaknuma Palace', category: 'Hotel', city: 'Hyderabad', area: 'Falaknuma', rating: 4.9, description: 'Grand hilltop palace hotel offering royal Nizam suite experiences, horse carriages, and heritage dinners.', price_tier: 'Luxury', price_inr: 38000, stars: 5});
CREATE (:Place:Hotel {id: 'hyd_the_park', name: 'The Park Hyderabad', category: 'Hotel', city: 'Hyderabad', area: 'Somajiguda', rating: 4.6, description: 'Boutique luxury hotel with glistening jeweled facade overlooking the scenic Hussain Sagar Lake.', price_tier: 'Moderate', price_inr: 8200, stars: 5});
CREATE (:Place:Hotel {id: 'hyd_hotel_shadab_inn', name: 'Hotel Shadab Lodge', category: 'Hotel', city: 'Hyderabad', area: 'Ghansi Bazaar', rating: 4.1, description: 'Convenient budget hotel located right in the vibrant heritage shopping district of Charminar.', price_tier: 'Budget', price_inr: 1600, stars: 2});
CREATE (:Place:Hotel {id: 'hyd_marigold', name: 'Marigold Hotel', category: 'Hotel', city: 'Hyderabad', area: 'Begumpet', rating: 4.5, description: 'Elegant business & tourist hotel featuring contemporary rooms, swimming pool, and central metro access.', price_tier: 'Moderate', price_inr: 5200, stars: 4});
CREATE (:Place:Restaurant {id: 'hyd_paradise_biryani', name: 'Paradise Biryani', category: 'Restaurant', city: 'Hyderabad', area: 'Secunderabad', rating: 4.6, description: 'Legendary institution founded in 1953, celebrated globally for fragrant saffron dum biryani.', price_tier: 'Budget', price_inr: 650, cuisine: 'World-Famous Hyderabadi Dum Biryani'});
CREATE (:Place:Restaurant {id: 'hyd_shadab_restaurant', name: 'Hotel Shadab', category: 'Restaurant', city: 'Hyderabad', area: 'Charminar (Madina)', rating: 4.6, description: 'Cult foodie hotspot near Charminar famous for aromatic mutton biryani, paya, and Zafrani tea.', price_tier: 'Budget', price_inr: 500, cuisine: 'Hyderabadi Mughlai, Biryani & Haleem'});
CREATE (:Place:Restaurant {id: 'hyd_bawarchi', name: 'Bawarchi Restaurant', category: 'Restaurant', city: 'Hyderabad', area: 'RTC X Roads', rating: 4.5, description: 'Hugely popular restaurant praised for massive, flavour-packed portions of spicy chicken and mutton biryani.', price_tier: 'Budget', price_inr: 550, cuisine: 'Authentic Hyderabadi Biryani & Kebabs'});
CREATE (:Place:Restaurant {id: 'hyd_chutneys', name: 'Chutneys', category: 'Restaurant', city: 'Hyderabad', area: 'Banjara Hills', rating: 4.5, description: 'Renowned South Indian chain famous for Guntur Steamed Dosa served with six varieties of flavorful chutneys.', price_tier: 'Budget', price_inr: 450, cuisine: 'South Indian Vegetarian & Steamed Dosa'});
CREATE (:Place:MetroStation {id: 'hyd_metro_mgbs', name: 'MGBS Metro Interchange', category: 'MetroStation', city: 'Hyderabad', area: 'Imlibun', rating: 4.7, description: 'Major multimodal transit hub beside Salar Jung Museum and Mahatma Gandhi Bus Station.', price_tier: 'Transit', line: 'Red & Green Line Interchange'});
CREATE (:Place:MetroStation {id: 'hyd_metro_charminar', name: 'Charminar Metro Station', category: 'MetroStation', city: 'Hyderabad', area: 'Sultan Bazaar', rating: 4.5, description: 'Underground metro station providing swift transit access to Charminar and Old City markets.', price_tier: 'Transit', line: 'Green Line'});
CREATE (:Place:MetroStation {id: 'hyd_metro_hitec', name: 'HITEC City Metro Station', category: 'MetroStation', city: 'Hyderabad', area: 'Madhapur', rating: 4.6, description: 'Terminal metro station connecting the heritage city to Hyderabad\'s modern IT and financial district.', price_tier: 'Transit', line: 'Blue Line'});

